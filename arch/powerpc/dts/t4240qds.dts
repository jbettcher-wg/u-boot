/include/ "t4240.dtsi"

/ {
	model = "fsl,T4240QDS";
	compatible = "fsl,T4240QDS";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&mpic>;

	aliases {
		spi0 = &espi0;
		serial0 = &serial0;
		serial1 = &serial1;
		serial2 = &serial2;
		serial3 = &serial3;
		/* Match Linux: bus 0 is the controller at 0x118000 (SPD / PCA9547). */
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
	};
};

/*
 * SoC .dtsi stubs use clock-frequency = <0>. SPD / mux bring-up is conservative
 * standard-mode (100 kHz); raise in board DT only if you need faster peripherals.
 */
&i2c0 {
	clock-frequency = <100000>;
	status = "okay";

	fpga@66 {
		compatible = "fsl,qixis";
		reg = <0x66>;
	};

	mux@77 {
		compatible = "nxp,pca9547";
		reg = <0x77>;
		#address-cells = <1>;
		#size-cells = <0>;

		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
		};

		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
		};

		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;
		};

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
		};
	};
};

/*
 * U-Boot: onboard RGMII on FM1@DTSEC5 (PHY MDIO addr 2) and FM2@DTSEC5 (addr 1),
 * both on the EMI1 RGMII mux (board eth.c / Linux phyrgmii1+2). Other DTSECs stay
 * disabled so boot stays light; Linux still enables SerDes / slots / 10G as needed.
 *
 * All four PCIe controllers stay enabled: only pcie@ffe260000 overrides ranges
 * (fragment must target /pcie@ffe260000 — in t4240.dtsi PCIe is NOT under soc).
 */
&soc {
	fman@400000 {
		ethernet@e0000 {
			status = "disabled";
		};

		ethernet@e2000 {
			status = "disabled";
		};

		ethernet@e4000 {
			status = "disabled";
		};

		ethernet@e6000 {
			status = "disabled";
		};

		ethernet@e8000 {
			phy-handle = <&onboard_rgmii_phy>;
			phy-connection-type = "rgmii";
		};

		ethernet@ea000 {
			status = "disabled";
		};

		ethernet@f0000 {
			status = "disabled";
		};

		ethernet@f2000 {
			status = "disabled";
		};
	};

	fman@500000 {
		ethernet@e0000 {
			status = "disabled";
		};

		ethernet@e2000 {
			status = "disabled";
		};

		ethernet@e4000 {
			status = "disabled";
		};

		ethernet@e6000 {
			status = "disabled";
		};

		ethernet@e8000 {
			phy-handle = <&onboard_rgmii2_phy>;
			phy-connection-type = "rgmii";
		};

		ethernet@ea000 {
			status = "disabled";
		};

		ethernet@f0000 {
			status = "disabled";
		};

		ethernet@f2000 {
			status = "disabled";
		};

		mdio@5fc000 {
			/*
			 * FM2 MEMAC MDIO + QIXIS EMI1_RGMII mux: PHY 2 = FM1 DTSEC5,
			 * PHY 1 = FM2 DTSEC5 (CFG_SYS_FM2_DTSEC_MDIO_ADDR + eth.c).
			 */
			onboard_rgmii2_phy: ethernet-phy@1 {
				reg = <0x1>;
			};

			onboard_rgmii_phy: ethernet-phy@2 {
				reg = <0x2>;
			};
		};

		mdio@5fd000 {
			status = "disabled";
		};
	};
};

/*
 * Same ranges as Linux arch/powerpc/boot/dts/fsl/t4240qds.dts (pci2).
 * Must use &{/...} — t4240.dtsi places PCIe under /, not under &soc.
 */
&{/pcie@ffe260000} {
	ranges = <0x01000000 0x0 0x00000000 0xf 0xf8020000 0x0 0x00010000
		  0x02000000 0x0 0xe0000000 0xc 0x80000000 0x0 0x20000000
		  0x43000000 0x2 0x0 0x0e 0x0 0x2 0x00000000>;
};

&espi0 {
	status = "okay";
	flash@0 {
		compatible = "jedec,spi-nor";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0>;
		spi-max-frequency = <10000000>; /* input clock */
	};
};

/*
 * PCIe3 MMIO (above): pcie@ffe260000, LAW target 0x02 per RM.
 *
 * Decoder inventory (CPU real / local map, typical QDS + full 48 GiB DRAM @ 0):
 *   [0, 0xC00000000)     — DDR (six-DIMM / SPD layout; do not place MMIO here)
 *   [0xC00000000, 0xC80000000) — PCIe1/2/4 keep NXP 512 MiB each (t4240.dtsi).
 *     PCIe3’s former 512 MiB slot (0xc4..0xc6) is unused with this override.
 *   [0xC80000000, 0xCA0000000) — PCIe3 non-prefetch MEM, 512 MiB (override)
 *   [0xE00000000, 0x1000000000) — PCIe3 prefetch MEM, 8 GiB (PCI 0x200000000+)
 *   0xFE0000000 region     — CCSR (default; relocatable via CCSRBAR)
 *   0xF_E000_0000 + …      — IFC NOR (T4240QDS.h)
 *   0xF_FDF0_0000          — QIXIS (IFC CS)
 *   0xFF4000000 / 0xFF6000000 — BMan / QMan (32 MiB each, if enabled)
 *
 * Prefetch CPU base 0xe00000000 matches Linux pci2 so LAW from pcie_fsl.c
 * covers the same PAs the kernel maps with outbound ATMU.
 *
 * U-Boot: drivers/pci/pcie_fsl.c programs LAW + outbound ATMU from "ranges".
 */

/include/ "t4240si-post.dtsi"
