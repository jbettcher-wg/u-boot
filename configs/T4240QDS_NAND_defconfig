# T4240QDS NAND+SPL+PBL — SPL loads U-Boot from NAND; runtime Kconfig matches
# T4240QDS_defconfig where applicable (DDR/PCI/DM/FMan/NXID). Build:
# make T4240QDS_NAND_defconfig && make olddefconfig && make ARCH=powerpc -j$(nproc)
# CRITICAL: CONFIG_SYS_MALLOC_F_LEN=0x3000 — SPD/I2C pre-reloc malloc_f > default 0x400 (overrun → cache/stack corruption, crash in training).
